# Autonome environment template
# Copy to .env and replace placeholders. Never commit real secrets.
# Load order: .env -> .env.local (overrides)

# -------------------------------------------------------------------
# Server & Database
# -------------------------------------------------------------------
# API_PORT (not PORT) - avoids collision with Vite/Nitro's built-in PORT handling
API_PORT=8081
FRONTEND_PORT=5173
SERVER_URL=http://localhost:3000
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://autonome.app,https://autonome.vercel.app
CORS_ORIGINS=http://localhost:5173
API_URL=http://localhost:8081
DATABASE_URL=****************************************************/autonome

# -------------------------------------------------------------------
# Alpaca Paper Trading
# -------------------------------------------------------------------
# Global toggle: "true" = paper-api.alpaca.markets, "false" = live
# Seed uses these per-model paper accounts, then stores them in "Models".
ALPACA_PAPER=true
ALPACA_MINIMAX_API_KEY=
ALPACA_MINIMAX_API_SECRET=
ALPACA_STEP_API_KEY=
ALPACA_STEP_API_SECRET=
ALPACA_NEMOTRON_API_KEY=
ALPACA_NEMOTRON_API_SECRET=

# -------------------------------------------------------------------
# AI Providers (at least one required)
# -------------------------------------------------------------------
# OpenRouter (primary - most models go through here)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY1=

# NVIDIA NIM
NIM_API_KEY=
NIM_API_KEY1=
NIM_API_KEY2=
NIM_API_KEY3=

# AIHubMix
AIHUBMIX_API_KEY=
AIHUBMIX_API_KEY1=
AIHUBMIX_API_KEY2=
AIHUBMIX_API_KEY3=
AIHUBMIX_API_KEY4=
AIHUBMIX_API_KEY5=

# Mistral (optional)
MISTRAL_API_KEY=

# -------------------------------------------------------------------
# Technical Analysis (optional)
# -------------------------------------------------------------------
# Single key (backward compatible)
TAAPI_API_KEY=
# Additional keys for round-robin rotation (up to 4 total)
# On free plan (1 req/15s), 3 keys = 1 request/5s effective rate
TAAPI_API_KEY1=
TAAPI_API_KEY2=
TAAPI_API_KEY3=

# -------------------------------------------------------------------
# Fallback Model (optional)
# -------------------------------------------------------------------
# Reasoning-model fallback when a competition has only one model
FALLBACK_MODEL=

# -------------------------------------------------------------------
# Frontend (Vite - client-exposed, prefixed with VITE_)
# -------------------------------------------------------------------
VITE_API_URL=http://localhost:8081
VITE_APP_TITLE=Autonome
