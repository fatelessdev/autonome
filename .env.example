# Autonome environment template
# Copy to .env and replace placeholders. Never commit real secrets.
# Load order: .env → .env.local (overrides)

# -------------------------------------------------------------------
# Server & Database
# -------------------------------------------------------------------
# API_PORT (not PORT) — avoids collision with Vite/Nitro's built-in PORT handling
API_PORT=8081
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://autonome.app,https://autonome.vercel.app
CORS_ORIGINS=http://localhost:5173
API_URL=http://localhost:8081
DATABASE_URL=postgresql://autonome:autonome_secret@localhost:5432/autonome

# -------------------------------------------------------------------
# Alpaca Paper Trading
# -------------------------------------------------------------------
# Global toggle: "true" = paper-api.alpaca.markets, "false" = live
# Per-model API keys are stored in the "Models" DB table, NOT here.
# After seeding, update each model row with real Alpaca credentials.
ALPACA_PAPER=true

# -------------------------------------------------------------------
# Workflow DevKit (Durable Workflows)
# -------------------------------------------------------------------
# Postgres connection for workflow state persistence.
# Can reuse DATABASE_URL or point to a separate DB.
WORKFLOW_POSTGRES_URL=postgresql://autonome:autonome_secret@localhost:5432/autonome

# -------------------------------------------------------------------
# AI Providers (at least one required)
# -------------------------------------------------------------------
# OpenRouter (primary — most models go through here)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY1=

# NVIDIA NIM
NIM_API_KEY=
NIM_API_KEY1=
NIM_API_KEY2=
NIM_API_KEY3=

# AIHubMix
AIHUBMIX_API_KEY=
AIHUBMIX_API_KEY1=
AIHUBMIX_API_KEY2=
AIHUBMIX_API_KEY3=
AIHUBMIX_API_KEY4=
AIHUBMIX_API_KEY5=

# Mistral (optional)
MISTRAL_API_KEY=

# -------------------------------------------------------------------
# Technical Analysis (optional)
# -------------------------------------------------------------------
TAAPI_API_KEY=

# -------------------------------------------------------------------
# Frontend (Vite — client-exposed, prefixed with VITE_)
# -------------------------------------------------------------------
VITE_API_URL=http://localhost:8081
VITE_APP_TITLE=Autonome
